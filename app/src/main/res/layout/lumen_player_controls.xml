<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000">
    <LinearLayout android:id="@+id/lumen_middle" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/lumen_previous" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Предыдущая серия" />
        <ImageButton android:id="@id/exo_play_pause" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginLeft="72dp" android:layout_marginRight="72dp" android:background="@android:color/transparent" android:contentDescription="Пауза / воспроизведение" />
        <ImageButton android:id="@+id/lumen_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="Следующая серия" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginBottom="18dp" android:paddingLeft="16dp" android:paddingRight="16dp" android:orientation="vertical">
        <TextView android:id="@+id/lumen_end_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3E3E3" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start">
            <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3E3E3" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" / " android:textColor="#E3E3E3" />
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3E3E3" android:textSize="14sp" />
        </LinearLayout>
        <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="match_parent" android:layout_height="32dp" app:played_color="#E3E3E3" app:scrubber_color="#E3E3E3" app:buffered_color="#999999" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:textColor="#E3E3E3" android:textSize="14sp" />
                <TextView android:id="@+id/lumen_track_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E3E3E3" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/lumen_bottom_actions" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end|center_vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
